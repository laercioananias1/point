# Build de produção (pedido do usuário, 2026-08-30: "subir pra produção") —
# diferente do Dockerfile de dev (roda `npm run dev`, serve sem build, bind
# mount do código-fonte): aqui compila os estáticos e serve com nginx, sem
# Node nenhum rodando em produção.
#
# VITE_API_URL precisa vir como build arg (não env var de runtime) — o Vite
# resolve import.meta.env.* na hora do build, embutido no JS final; não dá
# pra trocar depois sem rebuildar a imagem.
FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
