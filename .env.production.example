# Copie para .env.production no servidor e preencha os valores reais —
# esse arquivo (o .example) é o único que entra no git; o de verdade tem
# segredo e NUNCA deve ser commitado (já está no .gitignore).
#
# Uso: docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build

# --- Banco ---
DB_ROOT_PASSWORD=troque-por-uma-senha-forte

# --- Auth ---
# Gere um valor aleatório de verdade, não deixe o padrão de dev:
#   openssl rand -hex 32
JWT_SECRET=troque-por-um-valor-aleatorio-longo

# --- E-mail (convites) — via Resend, https://resend.com ---
RESEND_API_KEY=
RESEND_FROM=OPoint <onboarding@resend.dev>

# --- URLs ---
# Pedido do usuário, 2026-09-09: opoint.com.br/www.opoint.com.br passam a
# ser o site institucional (serviço `landing`); o painel/app mudou pra
# app.opoint.com.br (ver DEPLOY.md seção 4).
#
# Onde o painel vai responder (usada nos links de e-mail de convite).
FRONTEND_URL=https://app.opoint.com.br
# Origem(ns) liberada(s) no CORS da API — o domínio do painel, exatamente
# como aparece na barra de endereço (com https://, sem barra no final).
# Várias origens: separe por vírgula. Não precisa incluir opoint.com.br
# (o site institucional não chama a API).
CORS_ORIGINS=https://app.opoint.com.br
# URL da API que o FRONT embute no build (ver frontend/Dockerfile.prod) —
# se o nginx do host roteia /api/ pra API (ver DEPLOY.md), é o próprio
# domínio do app + /api.
VITE_API_URL=https://app.opoint.com.br/api

# --- TotalPass (opcional — deixe em branco se ainda não integrou) ---
TOTALPASS_PARTNER_API_KEY=
TOTALPASS_BASE_URL=https://booking-api.staging.totalpass.com
